# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# Local runtime databases (added manually — ruflo's default .gitignore misses these)
ruvector.db
ruvector.db-shm
ruvector.db-wal
.swarm/*.db
.swarm/*.db-shm
.swarm/*.db-wal

# Daemon runtime state — machine-local, embeds absolute paths
.claude-flow/daemon-state.json
