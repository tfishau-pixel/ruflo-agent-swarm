# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/daemon-state.json
.claude-flow/daemon.pid
.claude-flow/harness-active-policy.json
.claude-flow/metrics/
.claude-flow/policy/
.claude/.proven-config-version
.claude/proven-config.json

# Local runtime databases (added manually — ruflo's default .gitignore misses these)
ruvector.db
ruvector.db-shm
ruvector.db-wal
.swarm/*.db
.swarm/*.db-shm
.swarm/*.db-wal

# Obsidian vault — version notes and stable settings, not volatile workspace state
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/workspace.json.bak
vault/.obsidian/cache/
vault/.trash/
.DS_Store
