filters:
  and:
    - file.inFolder("06 AI Workspace")
    - file.ext == "md"
views:
  - type: table
    name: Pending Review
    filters:
      and:
        - file.inFolder("06 AI Workspace/Pending Review")
    order:
      - file.name
      - file.mtime
  - type: table
    name: All AI Material
    order:
      - file.folder
      - file.name
      - file.mtime
